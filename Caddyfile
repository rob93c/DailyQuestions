{
	admin off
	persist_config off
	auto_https off
	log {
		format json
		level WARN
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT} {
	log {
		format filter {
			wrap json
			request>headers delete
		}
	}
	log_append service "daily-questions"
	log_append event "http.request.completed"
	log_append request_id {http.request.header.X-Railway-Request-Id}
	log_append device_user_agent {http.request.header.User-Agent}

	respond /health 200

	root * dist

	encode gzip

	file_server

	try_files {path} /index.html
}
